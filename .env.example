# 360智脑开放平台（OpenAI 兼容）。base_url 与模型名从控制台获取，填好后另存为 .env
LLM_BASE_URL=https://api.360.cn/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-model-name
LLM_VISION_MODEL=your-vision-model-name  # 可选；视觉抽检用，留空则复用 LLM_MODEL
FONT_PATH=C:/Windows/Fonts/msyh.ttc
LLM_TIMEOUT_S=600  # 单次请求超时（秒）；表格架构师重建大表时生成耗时长，需要调大
